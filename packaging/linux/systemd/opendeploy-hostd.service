[Unit]
Description=OpenDeploy host agent (hostd, root)
Documentation=https://github.com/anreddykarthikreddy3003/opendeploy
PartOf=opendeploy.target
After=network-online.target
Wants=network-online.target

[Service]
# Extra trust anchors (enterprise TLS inspection): PEM files in /etc/opendeploy/ca.d.
Environment=SSL_CERT_DIR=/etc/ssl/certs:/etc/opendeploy/ca.d
Type=simple
User=root
Group=root
SupplementaryGroups=od-ipc
ExecStart=/opt/opendeploy/current/bin/opendeploy-hostd --config /etc/opendeploy/node.yaml
Restart=always
RestartSec=2
ReadWritePaths=/opt/opendeploy /var/lib/opendeploy /run/opendeploy
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_KILL
AmbientCapabilities=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_KILL
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=opendeploy.target
