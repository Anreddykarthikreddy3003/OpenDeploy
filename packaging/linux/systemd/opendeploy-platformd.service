[Unit]
Description=OpenDeploy control plane (platformd)
Documentation=https://github.com/anreddykarthikreddy3003/opendeploy
PartOf=opendeploy.target
After=network-online.target opendeploy-auditd.service opendeploy-secretd.service opendeploy-runtimed.service opendeploy-routemgr.service
Wants=network-online.target

[Service]
Type=simple
User=od-platformd
Group=od-platformd
SupplementaryGroups=od-ipc od-backup od-sources
ExecStart=/opt/opendeploy/current/bin/platformd --config /etc/opendeploy/node.yaml
Restart=always
RestartSec=2
ReadWritePaths=/var/lib/opendeploy/platformd /var/lib/opendeploy/sources /var/lib/opendeploy/backup-staging /var/lib/opendeploy/backups /run/opendeploy
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0077

[Install]
WantedBy=opendeploy.target
