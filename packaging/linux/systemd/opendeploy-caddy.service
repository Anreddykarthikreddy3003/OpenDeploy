[Unit]
Description=OpenDeploy edge proxy (Caddy, managed by routemgr)
PartOf=opendeploy.target
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=od-caddy
Group=od-caddy
ExecStart=/usr/bin/caddy run --environ --config /etc/opendeploy/caddy.json
ExecReload=/bin/kill -USR1 $MAINPID
Restart=always
RestartSec=2
Environment=XDG_DATA_HOME=/var/lib/opendeploy/caddy XDG_CONFIG_HOME=/var/lib/opendeploy/caddy
ReadWritePaths=/var/lib/opendeploy/caddy /run/opendeploy/caddy
ReadOnlyPaths=/var/lib/opendeploy/artifactd/store/static
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
LimitNOFILE=1048576
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
UMask=0007

[Install]
WantedBy=opendeploy.target
