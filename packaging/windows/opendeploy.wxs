<?xml version="1.0" encoding="UTF-8"?>
<!--
  OpenDeploy for Windows (WiX Toolset v4+):

    wix build -arch x64 -d Version=2.1.0 -d BinDir=dist\windows\bin -d GuestDir=dist\guest\wsl2-amd64 ^
      packaging\windows\opendeploy.wxs -o dist\OpenDeploy-2.1.0-x64.msi

  Installs opendeploy-desktop and opendeployctl under Program Files and the
  managed WSL distribution image, then registers the OpenDeploy Windows
  service (dedicated service account, starts at boot without a user login).

  Public properties:
    INSTALLFOLDER  program files (default C:\Program Files\OpenDeploy)
    DATADIR        the node's data: WSL disk, status, logs (default
                   %ProgramData%\OpenDeploy). Only for a first install:
                   upgrades and repairs keep the folder the service already
                   uses, and a different DATADIR is refused.
    e.g. msiexec /i OpenDeploy-x64.msi DATADIR=A:\OpenDeploy

  Uninstall removes the service; the node data is kept unless
  `opendeploy-desktop uninstall -purge` is run first.
  Sign the MSI and binaries with Authenticode before distribution.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="OpenDeploy" Manufacturer="OpenDeploy" Version="$(var.Version)"
           UpgradeCode="531018ef-ac44-4393-8356-ae68d033559a" Scope="perMachine" Compressed="yes" InstallerVersion="500">
    <SummaryInformation Description="OpenDeploy - local-first deployment platform" />
    <!-- Stop the running service before the old version's files are replaced. -->
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of OpenDeploy is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Launch Condition="Installed OR VersionNT64 &gt;= 603" Message="OpenDeploy requires 64-bit Windows 10 or later with WSL 2." />

    <!-- The data folder. opendeploy-desktop validates it and keeps the source
         of truth (the service's own arguments); KEPTDATADIR is the folder the
         last install recorded, read here only to refuse a move early with a
         readable message. -->
    <Property Id="DATADIR" Secure="yes" />
    <Property Id="KEPTDATADIR">
      <RegistrySearch Id="KeptDataDir" Root="HKLM" Key="SOFTWARE\OpenDeploy" Name="DataDir" Type="raw" Bitness="always64" />
    </Property>
    <SetProperty Id="KEPTDATADIRSLASH" Value="[KEPTDATADIR]\" After="AppSearch" Sequence="both" Condition="KEPTDATADIR" />
    <Launch Condition="Installed OR NOT DATADIR OR NOT KEPTDATADIR OR DATADIR ~= KEPTDATADIR OR DATADIR ~= KEPTDATADIRSLASH"
            Message="OpenDeploy already keeps its node data in [KEPTDATADIR]. Moving it to [DATADIR] is not supported. Install without DATADIR to keep the current folder, or first delete the node and all of its data with: opendeploy-desktop uninstall --purge" />

    <StandardDirectory Id="System64Folder" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="OpenDeploy">
        <Directory Id="BinDir" Name="bin">
          <Component Id="DesktopExe" Guid="*">
            <File Id="DesktopExeFile" Source="$(var.BinDir)\opendeploy-desktop.exe" KeyPath="yes" />
          </Component>
          <Component Id="CtlExe" Guid="*">
            <File Id="CtlExeFile" Source="$(var.BinDir)\opendeployctl.exe" KeyPath="yes" />
            <Environment Id="PathEntry" Name="PATH" Value="[BinDir]" Permanent="no" Part="last" Action="set" System="yes" />
          </Component>
        </Directory>
        <Directory Id="GuestDir" Name="guest">
          <Component Id="GuestImage" Guid="*">
            <File Id="GuestImageFile" Source="$(var.GuestDir)\opendeploy.wsl" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="OpenDeploy" Level="1">
      <ComponentRef Id="DesktopExe" />
      <ComponentRef Id="CtlExe" />
      <ComponentRef Id="GuestImage" />
    </Feature>

    <CustomAction Id="StopForUpgrade" Directory="System64Folder" ExeCommand="&quot;[System64Folder]net.exe&quot; stop OpenDeploy"
                  Execute="deferred" Impersonate="no" Return="ignore" />
    <!-- Without DATADIR, `install` follows the installed service's data folder
         (or the default). The space before the closing quote keeps a trailing
         backslash in DATADIR from escaping the quote; install trims it. -->
    <CustomAction Id="InstallService" FileRef="DesktopExeFile" ExeCommand="install" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="InstallServiceDataDir" FileRef="DesktopExeFile" ExeCommand="install --data &quot;[DATADIR] &quot;" Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="UninstallService" FileRef="DesktopExeFile" ExeCommand="uninstall" Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopForUpgrade" Before="RemoveExistingProducts" Condition="WIX_UPGRADE_DETECTED" />
      <Custom Action="UninstallService" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="InstallService" Before="InstallFinalize" Condition="NOT REMOVE AND NOT DATADIR" />
      <Custom Action="InstallServiceDataDir" Before="InstallFinalize" Condition="NOT REMOVE AND DATADIR" />
    </InstallExecuteSequence>
  </Package>
</Wix>
